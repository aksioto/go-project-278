# Deployment environment.
#
# TYPE: string
# REQUIRED: no
# DEFAULT: dev
ENV=dev

# Service identifier exposed in logs/Sentry release tags.
#
# TYPE: string
# REQUIRED: yes
# DEFAULT: —
SERVICE_NAME=servicename

# Application semantic version surfaced in logs/Sentry.
#
# TYPE: string
# REQUIRED: yes
# DEFAULT: —
APP_VERSION=1.0.0

# Public edge (Caddy) port.
#
# TYPE: integer
# REQUIRED: no
# DEFAULT: 80
PORT=80

# Internal Go HTTP server port.
#
# TYPE: integer
# REQUIRED: no
# DEFAULT: 8080
APP_PORT=8080

# Base URL used for generating absolute short links.
#
# TYPE: string (URL)
# REQUIRED: yes
# DEFAULT: —
BASE_URL=http://localhost:8080

# Directory containing Goose migrations.
#
# TYPE: path string
# REQUIRED: no
# DEFAULT: internal/db/migrations
MIGRATIONS_DIR=internal/db/migrations

# PostgreSQL DSN (used by app and migrations).
#
# TYPE: string (DSN)
# REQUIRED: yes
# DEFAULT: —
DATABASE_URL=postgres://postgres:password@db:5432/appdb?sslmode=disable

# Maximum open connections in pgx pool.
#
# TYPE: integer
# REQUIRED: no
# DEFAULT: 10
DATABASE_MAX_CONNS=10

# Idle timeout for pgx connections (milliseconds).
#
# TYPE: integer
# REQUIRED: no
# DEFAULT: 30000
DATABASE_IDLE_TIME_MS=30000

# Optional Sentry DSN (leave empty to disable).
#
# TYPE: string (URL)
# REQUIRED: no
# DEFAULT: —
SENTRY_DSN=https://**.sentry.io/***

# Sentry traces sample rate.
#
# TYPE: float (0..1)
# REQUIRED: no
# DEFAULT: 1.0
SENTRY_SAMPLE_RATE=1.0

# Flush timeout on shutdown (milliseconds).
#
# TYPE: integer
# REQUIRED: no
# DEFAULT: 2000
SENTRY_FLUSH_TIMEOUT_MS=2000

# Comma-separated CORS origins.
#
# TYPE: comma-separated list of strings
# REQUIRED: no
# DEFAULT: http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
